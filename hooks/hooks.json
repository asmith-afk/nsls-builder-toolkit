{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\"",
            "timeout": 90,
            "statusMessage": "Syncing builder toolkit..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-event.sh\"",
            "timeout": 5,
            "statusMessage": "Logging skill use so you get NSLS credit (nothing else)…"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guardrail-gate.py\"",
            "timeout": 10,
            "statusMessage": "Checking builder guardrails…"
          }
        ]
      }
    ]
  }
}
